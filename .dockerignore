# Keep the image lean and secret-free. Public NEXT_PUBLIC_* are passed as
# build-args; real secrets/envs never belong in the frontend image.

# ---- VCS / editor ----
.git
.gitignore
.idea
.vscode

# ---- Secrets & envs ----
.env
.env.*
**/*.pem
**/*.key
**/*.crt

# ---- Node / Next build artifacts (installed/built fresh in the image) ----
node_modules
.next
out
build
coverage
*.tsbuildinfo
.vercel

# ---- Logs / OS junk ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
